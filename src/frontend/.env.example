# Match the API's PublicMenu:AllowedMediaHosts. HTTPS hostnames only, comma-separated.
OMNI_REST_MEDIA_HOSTS=
# Set before building the frontend. Optional public Maps Embed API key. Restrict to the Embed API and deployed HTTP referrers.
# NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=
# Public URL scheme comes from deployment configuration, never forwarded request headers.
# OMNI_REST_PUBLIC_SCHEME=https
OMNI_REST_API_BASE_URL=http://127.0.0.1:5279
